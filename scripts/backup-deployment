#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

[[ ${EUID:-$(id -u)} == 0 ]] || { printf 'ROOT_REQUIRED\n' >&2; exit 1; }
base=${CHINA_PROXY_BASE:-/home/ubuntu/china-proxy-deployment}
lock_file=${BACKUP_LOCK:-/run/lock/china-proxy-backup.lock}
exec 9>"$lock_file"
flock -n 9 || { printf 'BACKUP_ALREADY_RUNNING\n' >&2; exit 1; }
stamp=$(date -u +%Y%m%dT%H%M%SZ)
destination="$base/backups/${stamp}-full"
tmpdir="${destination}.tmp.$$"
archive="$tmpdir/china-proxy-private.tgz"

cleanup() {
  rm -rf -- "$tmpdir"
}
trap cleanup ERR

install -d -m 700 "$tmpdir"

paths=()
for path in \
  /usr/local/bin/xray \
  /usr/local/bin/hysteria \
  /usr/local/bin/AdGuardHome \
  /usr/local/etc/xray/config.json \
  /etc/hysteria/config.yaml \
  /etc/adguardhome/AdGuardHome.yaml \
  /var/lib/adguardhome \
  /etc/systemd/system/xray.service \
  /etc/systemd/system/hysteria-server.service \
  /etc/systemd/system/adguardhome.service \
  "$base/client-configs" \
  "$base/private" \
  "$base/monitoring" \
  "$base/scripts" \
  "$base/state"; do
  [[ -e $path ]] && paths+=("${path#/}")
done

tar -C / -czf "$archive" "${paths[@]}"
chmod 600 "$archive"
(
  cd "$tmpdir"
  sha256sum "${archive##*/}" >SHA256SUMS
  chmod 600 SHA256SUMS
  sha256sum -c SHA256SUMS >/dev/null
)
# Atomic rename only after archive and checksum are valid
mv -T -- "$tmpdir" "$destination"
trap - ERR
printf 'backup=%s\n' "$destination"
