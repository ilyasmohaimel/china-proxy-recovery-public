#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/lib.sh"
load_probe_config
start=$(now_ms); success=false; error=
backup_root=${BACKUP_ROOT:-/home/ubuntu/china-proxy-deployment/backups}
max_age=${BACKUP_MAX_AGE_SECONDS:-604800}
newest=$(find "$backup_root" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2- || true)
if [[ -z $newest ]]; then
  error=BACKUP_MISSING
elif [[ ! -s "$newest/china-proxy-private.tgz" ]]; then
  error=BACKUP_INCOMPLETE
elif [[ ! -s "$newest/SHA256SUMS" ]]; then
  error=BACKUP_INCOMPLETE
elif ! (cd "$newest" && sha256sum -c SHA256SUMS >/dev/null 2>&1); then
  error=BACKUP_CHECKSUM_FAILED
elif (( $(date +%s) - $(stat -c %Y "$newest" 2>/dev/null || date +%s) > max_age )); then
  error=BACKUP_STALE
else
  success=true
fi
duration=$(($(now_ms)-start))
[[ $success == true ]] || { printf '%s\n' "$error" >&2; exit 1; }
printf 'BACKUP_OK duration_ms=%s\n' "$duration"
